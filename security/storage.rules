rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // New namespace must be empty or completely audited before activation.
    // ownerUid/mediaPolicy are only trustworthy after these rules are deployed.
    match /listing-media-v1/{uid}/{filename} {
      allow read: if request.auth != null;
      allow create: if resource == null && request.auth != null && request.auth.uid == uid
        && filename.matches('[A-Za-z0-9_-]+[.](jpg|jpeg|png|webp)')
        && request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.metadata.ownerUid == uid
        && request.resource.metadata.mediaPolicy == 'listing-v1';
      allow update, delete: if false;
    }
    // Retained product files are immutable, including changes to download tokens.
    match /products/{uid}/{filename} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /{path=**} { allow read, write: if false; }
  }
}
