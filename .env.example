# cherry backend environment template
# Copy this file to .env and fill in local values.
# Never commit real credentials.

# Server
PORT=3000
NODE_ENV=development

# Firebase
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_STORAGE_BUCKET=your_project.appspot.com

# Optional local admin credentials
FIREBASE_TYPE=service_account
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_CERT_URL=
FIREBASE_UNIVERSE_DOMAIN=googleapis.com

# Stripe
# Use test keys for local development and MVP verification.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Sendcloud
# Recommended for local work: mock mode.
# Use live mode only when you are intentionally testing the real integration.
SENDCLOUD_MODE=mock
SENDCLOUD_PUBLIC_KEY=your_sendcloud_public_key
SENDCLOUD_SECRET_KEY=your_sendcloud_secret_key
SENDCLOUD_API_URL=https://panel.sendcloud.sc/api/v2
SENDCLOUD_SERVICE_POINTS_API_URL=https://servicepoints.sendcloud.sc/api/v2
SENDCLOUD_ENFORCED_CARRIER=inpost_gb
SENDCLOUD_LABEL_MODE=test
SENDCLOUD_WEBHOOK_SIGNATURE_KEY=your_sendcloud_webhook_signature_key

# Email
EMAIL_MODE=off
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL="Cherry <notifications@example.com>"

# User products cursor encryption. Required for the user products endpoint.
# Generate 32 random bytes encoded as base64, store in the deployment secret
# manager, and use the same value across instances. Never commit a real key.
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
USER_PRODUCTS_CURSOR_KEY=

# Order hold and release
# Hours after carrier delivery during which the buyer can confirm or dispute and
# the order stays HELD. Defaults to 48 when unset; must be between 0 and 696.
ORDER_HOLD_PERIOD_HOURS=48
# Cloud Tasks schedules one authenticated release task per delivered order.
# These reuse the queue, audience and service account provisioned for
# fulfilment (CLOUD_TASKS_*, FULFILLMENT_WORKER_*); the ORDER_RELEASE_* values
# below override them when a dedicated queue or identity is used.
ORDER_RELEASE_WORKER_URL=https://your-service.example/api/internal/order-release/tasks
FULFILLMENT_WORKER_URL=https://your-service.example/api/internal/fulfillment/tasks
CLOUD_TASKS_PROJECT_ID=
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_QUEUE=
FULFILLMENT_WORKER_AUDIENCE=
FULFILLMENT_WORKER_SERVICE_ACCOUNT=
# ORDER_RELEASE_TASKS_QUEUE=
# ORDER_RELEASE_WORKER_AUDIENCE=
# ORDER_RELEASE_WORKER_SERVICE_ACCOUNT=
